{
  "name": "twomoons-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TCG Collector & Preis-Tracker für TwoMoons AG, Dübendorf",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "import:prices": "node scripts/import-prices.mjs",
    "deploy": "npm run build && npx --yes firebase-tools@latest deploy --only hosting"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
