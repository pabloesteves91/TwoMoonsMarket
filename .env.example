# Firebase-Konfiguration für den Cloud-Betrieb mit Login.
# Diese Datei nach .env.local kopieren und die Werte aus der Firebase-Konsole
# einsetzen: Projekteinstellungen → Allgemein → Meine Apps → Web-App → SDK-Konfiguration.
#
# Ohne .env.local läuft die App im lokalen Modus: keine Anmeldung, alle Daten
# bleiben in der IndexedDB des jeweiligen Browsers.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<projekt-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=<projekt-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemeinsamer Arbeitsbereich der Firma (Firestore: workspaces/<id>/…)
VITE_WORKSPACE_ID=twomoons

# Optional: erzwingt ein Backend unabhängig von der Konfiguration oben.
# local = ohne Login/IndexedDB, firebase = Firestore mit Login
# VITE_BACKEND=firebase
